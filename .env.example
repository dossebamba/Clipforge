# Copie ce fichier en ".env" et remplis les valeurs. Le vrai .env n'est jamais commité.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

LLM_PROVIDERS=gemini,groq,openrouter

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Authentification
# Inscriptions : ouvertes seulement tant qu'aucun compte n'existe. true = toujours ouvertes.
ALLOW_REGISTRATION=false
# Mettre true si l'accès se fait en HTTPS (cookie de session marqué Secure)
SECURE_COOKIES=false

# Modèles Gemini essayés dans l'ordre : le quota gratuit est compté par modèle, donc si le premier
# est épuisé, le suivant prend le relais (laisser vide pour garder la valeur par défaut).
# GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest
