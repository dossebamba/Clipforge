# Copie ce fichier en ".env" et remplis les valeurs. Le vrai .env n'est jamais commité.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

LLM_PROVIDERS=gemini,groq,openrouter

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Authentification
# Inscriptions : ouvertes seulement tant qu'aucun compte n'existe. true = toujours ouvertes.
ALLOW_REGISTRATION=false
# Mettre true si l'accès se fait en HTTPS (cookie de session marqué Secure)
SECURE_COOKIES=false
